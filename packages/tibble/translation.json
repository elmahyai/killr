          "r": "        suppressPackageStartupMessages(library(tibble))\ndf <- data.frame(a = 1)\n        one <- function() {\n          paste(c(has_name(df, \"a\"), has_name(df, \"nope\")), collapse = \",\")\n        }\n        ans <- one()\n        elapsed <- numeric(20)\n        for (i in seq_len(20)) {\n          t0 <- as.numeric(Sys.time())\n          one()\n          elapsed[[i]] <- as.numeric(Sys.time()) - t0\n        }\n        cat(ans, \"\\n\", sep = \"\")\n        cat(sprintf(\"%.17g\\n\", median(elapsed) * 1000))\n",
          "python": "import statistics\nimport time\n\nfrom tibble import has_name, new_tibble\nframe = new_tibble([[1]], names=[\"a\"], nrow=1)\ndef one():\n    return f\"{has_name(frame, 'a')},{has_name(frame, 'nope')}\"\n\nans = one()\nelapsed = []\nfor _ in range(20):\n    started = time.perf_counter()\n    one()\n    elapsed.append((time.perf_counter() - started) * 1000)\nprint(ans)\nprint(f\"{statistics.median(elapsed):.17g}\")\n"
