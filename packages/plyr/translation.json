        "proof": {
          "r": "suppressPackageStartupMessages(library(plyr))\nstopifnot(identical(as.character(packageVersion(\"plyr\")), \"1.8.9\"))\n\nn <- 20000L\nyear <- 1871L + (seq_len(n) %% 50L)\nteam <- LETTERS[((seq_len(n) %/% 50L) %% 26L) + 1L]\ng <- ((seq_len(n) * 13L) %% 160L) + 1L\ndf <- data.frame(year = year, team = team, g = g, stringsAsFactors = FALSE)\n\none <- function() count(df, c(\"year\", \"team\"), \"g\")\n\nvalue <- one()\nelapsed <- numeric(20)\nfor (i in seq_len(20)) {\n  t0 <- as.numeric(Sys.time())\n  one()\n  elapsed[[i]] <- as.numeric(Sys.time()) - t0\n}\n\nshown <- paste(sprintf(\"%d|%s|%.17g\", value$year, value$team, value$freq), collapse = \";\")\ncat(\"VALUE \", shown, \"\\n\", sep = \"\")\ncat(sprintf(\"MS %.17g\\n\", median(elapsed) * 1000))\n",
          "python": "import statistics\nimport sys\nimport time\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n\nfrom plyr.count import count\n\nn = 20000\nletters = [chr(ord(\"A\") + k) for k in range(26)]\nyear = []\nteam = []\ng = []\nfor i in range(1, n + 1):\n    year.append(1871 + (i % 50))\n    team.append(letters[(i // 50) % 26])\n    g.append((i * 13) % 160 + 1)\nframe = {\"year\": year, \"team\": team, \"g\": g}\n\n\ndef one():\n    return count(frame, [\"year\", \"team\"], \"g\")\n\n\nvalue = one()\nelapsed = []\nfor _ in range(20):\n    started = time.perf_counter()\n    one()\n    elapsed.append((time.perf_counter() - started) * 1000)\n\nparts = []\nfor y, label, freq in zip(value.columns[\"year\"], value.columns[\"team\"], value.columns[\"freq\"]):\n    parts.append(f\"{y}|{label}|{format(float(freq), '.17g')}\")\nprint(\"VALUE \" + \";\".join(parts))\nprint(f\"MS {statistics.median(elapsed):.17g}\")\n"
        }
      }
