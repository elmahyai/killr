      "check": {
        "case": "arrange of 200000 rows by a, b, and c, with ties, NA, NaN, infinities, and negative zero",
        "r_ms": 68.49789619445801,
        "translated_ms": 870.6965810000042,
        "speedup": 0.0786702252991363,
        "matches": true,
        "max_abs_diff": 0.0,
        "tolerance": 1e-08,
        "proof": {
          "r": "suppressPackageStartupMessages(library(plyr))\nstopifnot(identical(as.character(packageVersion(\"plyr\")), \"1.8.9\"))\n\nn <- 200000L\na <- (seq_len(n) * 17L) %% 23L\nb <- (seq_len(n) * 13L) %% 97 / 10\nc <- (seq_len(n) %% 11L) + (seq_len(n) %% 5L) / 2\na[seq(10L, n, 1000L)] <- NA\nb[seq(20L, n, 1500L)] <- NA\nb[seq(30L, n, 2500L)] <- NaN\nc[seq(40L, n, 4000L)] <- Inf\nc[seq(50L, n, 4000L)] <- -Inf\nzeros <- which(b == 0)\nb[zeros] <- -0\ndf <- data.frame(a = a, b = b, c = c)\n\none <- function() arrange(df, a, b, c)\n\nvalue <- one()\nelapsed <- numeric(20)\nfor (i in seq_len(20)) {\n  t0 <- as.numeric(Sys.time())\n  one()\n  elapsed[[i]] <- as.numeric(Sys.time()) - t0\n}\n\nshow_a <- function(v) ifelse(is.na(v), \"NA\", sprintf(\"%d\", v))\nshow_d <- function(v) {\n  ifelse(\n    is.nan(v),\n    \"NaN\",\n    ifelse(is.na(v), \"NA\", ifelse(is.infinite(v), ifelse(v > 0, \"Inf\", \"-Inf\"), sprintf(\"%a\", v)))\n  )\n}\ncat(\"A \", paste(show_a(value$a), collapse = \" \"), \"\\n\", sep = \"\")\ncat(\"B \", paste(show_d(value$b), collapse = \" \"), \"\\n\", sep = \"\")\ncat(\"C \", paste(show_d(value$c), collapse = \" \"), \"\\n\", sep = \"\")\ncat(sprintf(\"MS %.17g\\n\", median(elapsed) * 1000))\n",
          "python": "import math\nimport statistics\nimport sys\nimport time\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n\nfrom plyr.arrange import arrange\n\nn = 200000\na = [(i * 17) % 23 for i in range(1, n + 1)]\nb = [((i * 13) % 97) / 10 for i in range(1, n + 1)]\nc = [(i % 11) + (i % 5) / 2 for i in range(1, n + 1)]\nfor i in range(10, n + 1, 1000):\n    a[i - 1] = None\nfor i in range(20, n + 1, 1500):\n    b[i - 1] = None\nfor i in range(30, n + 1, 2500):\n    b[i - 1] = float(\"nan\")\nfor i in range(40, n + 1, 4000):\n    c[i - 1] = float(\"inf\")\nfor i in range(50, n + 1, 4000):\n    c[i - 1] = float(\"-inf\")\nfor index, value in enumerate(b):\n    if value == 0:\n        b[index] = -0.0\nframe = {\"a\": a, \"b\": b, \"c\": c}\n\n\ndef one():\n    return arrange(frame, \"a\", \"b\", \"c\")\n\n\ndef show_a(value):\n    return \"NA\" if value is None else str(int(value))\n\n\ndef show_d(value):\n    if value is None:\n        return \"NA\"\n    number = float(value)\n    if math.isnan(number):\n        return \"NaN\"\n    if math.isinf(number):\n        return \"Inf\" if number > 0 else \"-Inf\"\n    return number.hex()\n\n\nvalue = one()\nelapsed = []\nfor _ in range(20):\n    started = time.perf_counter()\n    one()\n    elapsed.append((time.perf_counter() - started) * 1000)\n\nprint(\"A \" + \" \".join(show_a(item) for item in value.columns[\"a\"]))\nprint(\"B \" + \" \".join(show_d(item) for item in value.columns[\"b\"]))\nprint(\"C \" + \" \".join(show_d(item) for item in value.columns[\"c\"]))\nprint(f\"MS {statistics.median(elapsed):.17g}\")\n"
        }
      }
    },
