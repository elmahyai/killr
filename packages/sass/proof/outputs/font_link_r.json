{
  "function": "font_link",
  "primary_case": "plain",
  "r_ms": 0.2936,
  "sass_version": "0.4.10",
  "r_version": "R version 4.5.0 (2025-04-11)",
  "cases": {
    "plain": {
      "families": [
        "'Open Sans'"
      ],
      "default_flag": true,
      "html_deps": [
        {
          "name": "Open_Sans",
          "version": "0.4.10",
          "kind": "link",
          "href": "https://fonts.example.com/css2?family=Open+Sans&display=swap",
          "head": "<link href=\"https://fonts.example.com/css2?family=Open+Sans&amp;display=swap\" rel=\"stylesheet\"/>",
          "stylesheet": null
        }
      ]
    },
    "escaped": {
      "families": [
        "Lato"
      ],
      "default_flag": true,
      "html_deps": [
        {
          "name": "Lato",
          "version": "0.4.10",
          "kind": "link",
          "href": "https://example.com/a b.css?x='1'&y=2",
          "head": "<link href=\"https://example.com/a%20b.css?x=&#39;1&#39;&amp;y=2\" rel=\"stylesheet\"/>",
          "stylesheet": null
        }
      ]
    },
    "bad_family": {
      "error": "error"
    }
  }
}
