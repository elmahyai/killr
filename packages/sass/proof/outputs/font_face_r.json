{
  "function": "font_face",
  "primary_case": "vectors",
  "r_ms": 0.7055,
  "sass_version": "0.4.10",
  "r_version": "R version 4.5.0 (2025-04-11)",
  "cases": {
    "basic": {
      "families": [
        "'Open Sans'"
      ],
      "default_flag": true,
      "html_deps": [
        {
          "name": "'Open_Sans'",
          "version": "0.4.10",
          "kind": "face",
          "href": null,
          "head": null,
          "stylesheet": "@font-face {\n  font-family: 'Open Sans';\n  src: url(a.woff2);\n  font-weight: 400;\n  font-style: normal;\n  font-display: swap;\n}"
        }
      ]
    },
    "vectors": {
      "families": [
        "Roboto, 'Helvetica Neue'"
      ],
      "default_flag": true,
      "html_deps": [
        {
          "name": "Roboto,_'Helvetica_Neue'",
          "version": "0.4.10",
          "kind": "face",
          "href": null,
          "head": null,
          "stylesheet": "@font-face {\n  font-family: Roboto, 'Helvetica Neue';\n  src: url(a.woff2), url(b.woff);\n  font-display: block;\n  font-stretch: condensed;\n  font-variant: small-caps;\n  unicode_range: U+0000-00FF, U+0131;\n}"
        }
      ]
    },
    "no_display": {
      "families": [
        "Foo"
      ],
      "default_flag": true,
      "html_deps": [
        {
          "name": "Foo",
          "version": "0.4.10",
          "kind": "face",
          "href": null,
          "head": null,
          "stylesheet": "@font-face {\n  font-family: Foo;\n  src: url(f.woff2);\n}"
        }
      ]
    },
    "partial_display": {
      "families": [
        "Foo"
      ],
      "default_flag": true,
      "html_deps": [
        {
          "name": "Foo",
          "version": "0.4.10",
          "kind": "face",
          "href": null,
          "head": null,
          "stylesheet": "@font-face {\n  font-family: Foo;\n  src: url(f.woff2);\n  font-display: swap;\n}"
        }
      ]
    },
    "bad_display": {
      "error": "error"
    }
  }
}
