      "done": "Fills a numeric, Date, or POSIXct vector out to its period.",
      "not_done": "",
      "blocked_by": [],
      "assigned": "",
      "check": {
        "case": "full_seq on gaps, a tolerance pad, a short span, fractional and negative grids, Date, and POSIXct",
        "r_ms": 0.691533088684082,
        "translated_ms": 1.06218099972466,
        "speedup": 0.6510501401016796,
        "matches": true,
        "max_abs_diff": 0.0,
        "tolerance": 1e-08,
        "proof": {
          "r": "suppressPackageStartupMessages(library(tidyr))\nstopifnot(identical(as.character(packageVersion(\"tidyr\")), \"1.3.2\"))\ndays <- as.Date(\"2001-01-01\") + c(0, 2, 6)\nclock <- as.POSIXct(as.Date(\"2001-01-01\") + c(0, 2))\none <- function() {\n  gaps <- full_seq(c(1, 2, 4, 5, 10), 1)\n  tol <- full_seq(c(0, 10, 20), 11, tol = 2)\n  short <- full_seq(c(0, 10, 16), 11, tol = 5)\n  frac <- full_seq(c(0.1, 0.3, 0.7), 0.2)\n  grid <- full_seq(c(0, 0.3, 0.6, 1), 0.1)\n  neg <- full_seq(c(-4, -1, 2), 1.5)\n  dated <- full_seq(days, 2)\n  clocked <- full_seq(clock, 86400)\n  if (!inherits(dated, \"Date\")) stop(\"Date class was not restored\")\n  if (!identical(attr(clocked, \"tzone\"), \"UTC\")) stop(\"POSIXct tzone was not restored\")\n  c(gaps, tol, short, frac, grid, neg, as.numeric(dated), as.numeric(clocked))\n}\nvalue <- one()\nelapsed <- numeric(20)\nfor (i in seq_len(20)) {\n  t0 <- as.numeric(Sys.time())\n  one()\n  elapsed[[i]] <- as.numeric(Sys.time()) - t0\n}\ncat(sprintf(\n  '{\"value\":[%s],\"median_ms\":%.17g}\\n',\n  paste(sprintf(\"%.17g\", value), collapse = \",\"),\n  median(elapsed) * 1000\n))\n",
          "python": "import json\nimport statistics\nimport sys\nimport time\n\nimport numpy as np\n\nsys.path.insert(0, \"/home/ahmed/killr_projects/killr/packages/tidyr\")\nfrom tidyr.full_seq import Date, POSIXct, full_seq\n\ndays = Date([11323.0, 11325.0, 11329.0])\nclock = POSIXct([978307200.0, 978480000.0], tzone=\"UTC\")\n\n\ndef one():\n    gaps = full_seq(np.array([1, 2, 4, 5, 10], dtype=float), 1.0)\n    tol = full_seq(np.array([0, 10, 20], dtype=float), 11.0, tol=2.0)\n    short = full_seq(np.array([0, 10, 16], dtype=float), 11.0, tol=5.0)\n    frac = full_seq(np.array([0.1, 0.3, 0.7]), 0.2)\n    grid = full_seq(np.array([0.0, 0.3, 0.6, 1.0]), 0.1)\n    neg = full_seq(np.array([-4.0, -1.0, 2.0]), 1.5)\n    dated = full_seq(days, 2.0)\n    clocked = full_seq(clock, 86400.0)\n    if dated.classes != (\"Date\",):\n        raise RuntimeError(\"Date class was not restored\")\n    if clocked.tzone != \"UTC\" or clocked.classes != (\"POSIXct\", \"POSIXt\"):\n        raise RuntimeError(\"POSIXct tzone was not restored\")\n    return np.concatenate(\n        [\n            np.asarray(gaps, dtype=float),\n            np.asarray(tol, dtype=float),\n            np.asarray(short, dtype=float),\n            np.asarray(frac, dtype=float),\n            np.asarray(grid, dtype=float),\n            np.asarray(neg, dtype=float),\n            np.asarray(dated.days, dtype=float),\n            np.asarray(clocked.seconds, dtype=float),\n        ]\n    )\n\n\nvalue = one()\nelapsed = []\nfor _ in range(20):\n    started = time.perf_counter()\n    one()\n    elapsed.append((time.perf_counter() - started) * 1000)\nprint(json.dumps({\"value\": [float(item) for item in value], \"median_ms\": statistics.median(elapsed)}))\n"
        }
      }
